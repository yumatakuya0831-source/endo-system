# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/endo_system

# Set to "disable" only for local PostgreSQL without SSL.
POSTGRES_SSL=disable

# Comma-separated administrator emails.
ADMIN_EMAILS=yumatakuya0831@gmail.com

# Same emails for client-side UI visibility only. Server-side ADMIN_EMAILS is the source of truth.
NEXT_PUBLIC_ADMIN_EMAILS=yumatakuya0831@gmail.com

# First-login bootstrap password for ADMIN_EMAILS when the admin user does not exist yet.
ADMIN_INITIAL_PASSWORD=change-this-password
