# Supabase project API URL
NEXT_PUBLIC_SUPABASE_URL=https://jdbpsdgrowgpnykzvinl.supabase.co

# Supabase publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key. Server-side only; never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Data storage backend. Use "supabase" or "postgres".
NEXT_PUBLIC_DATA_BACKEND=supabase

# PostgreSQL connection string. Required when NEXT_PUBLIC_DATA_BACKEND=postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/endo_system

# Set to "disable" only for local PostgreSQL without SSL.
POSTGRES_SSL=disable

# Comma-separated emails allowed to create users from master management.
ADMIN_EMAILS=

# Same emails for client-side UI visibility only. Server-side ADMIN_EMAILS is the source of truth.
NEXT_PUBLIC_ADMIN_EMAILS=

# Optional: used only by npm run supabase:verify
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
